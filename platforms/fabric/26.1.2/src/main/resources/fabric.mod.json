{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "assets/waypointsplus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["pl.slogerski.waypointsplus.fabric.WaypointsPlusClient"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
